services:

  traefik:
    image: traefik:v3
    restart: always
    networks:
      - traefik
    command:
      - "--api.insecure=true"
      - "--api.dashboard=true"
      - "--providers.docker=true"
      - "--providers.docker.exposedbydefault=false"
      - "--entrypoints.web.address=:80"
      - "--entrypoints.web.http.redirections.entrypoint.to=websecure"
      - "--entrypoints.web.http.redirections.entrypoint.scheme=https"
      - "--entrypoints.websecure.address=:443"
      - "--certificatesresolvers.le.acme.email=REPLACE_WITH_ACME_EMAIL"
      - "--certificatesresolvers.le.acme.storage=/letsencrypt/acme.json"
      - "--certificatesresolvers.le.acme.httpchallenge.entrypoint=web"
      - "--accesslog"
    ports:
      - 80:80
      - 443:443
    expose:
      - 8080
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - ./storage/traefik/config/acme.json:/letsencrypt/acme.json
    labels:
      - "traefik.enable=true"

  nginx:
    image: nginx:latest
    restart: always
    networks:
      - traefik
    volumes:
      - ./storage/nginx/site:/usr/share/nginx/html
      - ./storage/nginx/matrix.conf:/etc/nginx/conf.d/matrix.conf
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=traefik"
      - "traefik.http.routers.nginx.rule=(Host(`REPLACE_WITH_HOSTNAME`) && PathPrefix(`/.well-known`)) || Host(`REPLACE_WITH_SITE_HOST`)"
      - "traefik.http.routers.nginx.priority=1" #long rule, so we knock its priority down to allow synapse rule to take over
      - "traefik.http.routers.nginx.entrypoints=websecure"
      - "traefik.http.routers.nginx.tls.certresolver=le"
      ## redirect base hostname to your site. change to REPLACE_WITH_ELEMENT_HOST if you want to redirect to Element instead.
      - "traefik.http.middlewares.to-site.redirectregex.regex=^https://REPLACE_WITH_HOSTNAME/$$"
      - "traefik.http.middlewares.to-site.redirectregex.replacement=https://REPLACE_WITH_REDIRECT_HOST/"
      - "traefik.http.routers.site.middlewares=to-site"
      - "traefik.http.routers.site.rule=Host(`REPLACE_WITH_HOSTNAME`)"
      - "traefik.http.routers.site.tls.certresolver=le"

  mas:
    image: ghcr.io/element-hq/matrix-authentication-service:REPLACE_WITH_MAS_VERSION_TAG
    restart: always
    expose:
      - 8080
    volumes:
      - ./storage/mas/data:/data
    networks:
      traefik:
        aliases:
          - mas
      postgres:
    command: server
    environment:
      MAS_CONFIG: /data/config.yaml
    depends_on:
      - postgresql
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=traefik"
      - "traefik.http.routers.mas.entrypoints=websecure"
      - "traefik.http.routers.mas.tls.certresolver=le"
      - "traefik.http.routers.mas.rule=(Host(`REPLACE_WITH_MATRIX_HOST`) && PathRegexp(`^/_matrix/client/.*/(login|logout|refresh)`)) || Host(`REPLACE_WITH_MAS_HOST`)"

  synapse:
    image: ghcr.io/element-hq/synapse:REPLACE_WITH_SYNAPSE_VERSION_TAG
    restart: always
    depends_on:
      - postgresql
    networks:
      - traefik
      - postgres
    volumes:
      - ./storage/synapse/data:/data
    environment:
      - UID=REPLACE_WITH_UID
      - GID=REPLACE_WITH_UID
    expose:
      - 8008
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=traefik"
      - "traefik.http.routers.synapse.entrypoints=websecure"
      - "traefik.http.routers.synapse.tls.certresolver=le"
      - "traefik.http.routers.synapse.rule=Host(`REPLACE_WITH_MATRIX_HOST`)"
      - "traefik.http.routers.synapse.priority=100"

  element:
    image: ghcr.io/element-hq/element-web:REPLACE_WITH_ELEMENT_VERSION_TAG
    restart: always
    networks:
      - traefik
    volumes:
      - ./storage/element/data/config.json:/app/config.json
    expose:
      - 80
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=traefik"
      - "traefik.http.routers.element.entrypoints=websecure"
      - "traefik.http.routers.element.tls.certresolver=le"
      - "traefik.http.routers.element.rule=Host(`REPLACE_WITH_ELEMENT_HOST`)"

  postgresql:
    image: postgres:REPLACE_WITH_POSTGRES_VERSION_TAG
    restart: always
    networks:
      postgres:
        aliases: 
          - database
    environment:
      - POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_ROOT_PW
    volumes:
      # PostgreSQL 18+ mounts /var/lib/postgresql (data in ./storage/postgresql/data/<major>/docker);
      # older versions mount /var/lib/postgresql/data directly
      - ./storage/postgresql/data:REPLACE_WITH_POSTGRES_DATA_PATH
      - ./storage/postgresql/init-db.sh:/docker-entrypoint-initdb.d/init-db.sh
    expose:
      - 5432

  # nightly logical backups of all databases into ./storage/backups/postgresql.
  # DUMP_SCHEDULE is cron format in TZ; change values here, then `docker compose up -d db-dump`.
  # Restore steps are at the top of ./storage/db-dump/db-dump.sh. Run one now with:
  #   docker compose exec db-dump sh /opt/db-dump/db-dump.sh
  db-dump:
    image: postgres:REPLACE_WITH_DB_DUMP_IMAGE_TAG
    restart: always
    init: true   # crond ignores SIGTERM as PID 1; without this every stop waits out the 10s timeout
    depends_on:
      - postgresql
    networks:
      - postgres
    environment:
      - TZ=REPLACE_WITH_TIMEZONE
      - DUMP_NAME=REPLACE_WITH_HOSTNAME
      - DUMP_SCHEDULE=REPLACE_WITH_DB_BACKUP_SCHEDULE
      - KEEP_DUMPS=REPLACE_WITH_DB_BACKUP_KEEP
      - PGHOST=database
      - PGUSER=postgres
      - PGPASSWORD=REPLACE_WITH_POSTGRES_ROOT_PW
      # optional: full ntfy topic URL (e.g. https://ntfy.sh/your-secret-topic) to be alerted on failure
      - BACKUP_NTFY_URL=REPLACE_WITH_DB_BACKUP_NTFY_URL
    volumes:
      - ./storage/backups/postgresql:/dumps
      - ./storage/db-dump:/opt/db-dump:ro
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        echo "$$DUMP_SCHEDULE sh /opt/db-dump/db-dump.sh > /proc/1/fd/1 2>&1" > /etc/crontabs/root
        exec crond -f -l 8

  # nightly synapse state compression (shrinks state_groups_state, Synapse's largest table).
  # COMPRESS_SCHEDULE is cron format in TZ; change it here, then `docker compose up -d synapse-compress-state`.
  # The compressor version is the FROM tag in ./storage/statecompressor/Dockerfile (then `up -d --build`).
  synapse-compress-state:
    build: ./storage/statecompressor
    restart: always
    init: true
    depends_on:
      - postgresql
    networks:
      - postgres
    environment:
      - POSTGRES_USER=synapse_user
      - POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PW
      - POSTGRES_DB=synapse
      - POSTGRES_HOST=database
      - TZ=REPLACE_WITH_TIMEZONE
      - COMPRESS_SCHEDULE=REPLACE_WITH_STATE_COMPRESSOR_SCHEDULE

  # matrix-rtc authentication layer, running as a Synapse application service
  # (registration: ./storage/synapse/data/lk-jwt-registration.yaml)
  jwt:
    restart: always
    image: ghcr.io/element-hq/lk-jwt-service:REPLACE_WITH_MATRIX_JWT_VERSION_TAG
    expose:
      - 8080
    networks:
      traefik:
        aliases:
          - jwt
    environment:
      - LIVEKIT_HS_SERVER_NAME=REPLACE_WITH_HOSTNAME
      - LIVEKIT_AS_TOKEN=REPLACE_WITH_LK_JWT_AS_TOKEN
      - LIVEKIT_HS_TOKEN=REPLACE_WITH_LK_JWT_HS_TOKEN
      # only used by the deprecated standalone endpoints that older clients still call
      - LIVEKIT_FULL_ACCESS_HOMESERVERS=REPLACE_WITH_HOSTNAME
      # must equal the transport url Synapse advertises (matrix_rtc in homeserver.yaml)
      - LIVEKIT_URL=wss://REPLACE_WITH_MATRIX_RTC_HOST/livekit/sfu
      - LIVEKIT_KEY=REPLACE_WITH_LIVEKIT_KEY
      - LIVEKIT_SECRET=REPLACE_WITH_LIVEKIT_SECRET
      # backstop for livekit's webhooks (storage/livekit/data/config.yaml): re-check participants every N seconds
      - LIVEKIT_SANITY_CHECK_INTERVAL_SECONDS=REPLACE_WITH_MATRIX_RTC_SANITY_CHECK_SECONDS
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=traefik"
      - "traefik.http.routers.jwt.entrypoints=websecure"
      - "traefik.http.routers.jwt.tls.certresolver=le"
      - "traefik.http.routers.jwt.rule=Host(`REPLACE_WITH_MATRIX_RTC_HOST`) && PathPrefix(`/livekit/jwt`)"
      - "traefik.http.routers.jwt.service=jwt"
      - "traefik.http.services.jwt.loadbalancer.server.port=8080"
      - "traefik.http.routers.jwt.middlewares=jwt-mw"
      - "traefik.http.middlewares.jwt-mw.stripprefix.prefixes=/livekit/jwt"

  # matrix-rtc SFU
  livekit:
    image: livekit/livekit-server:REPLACE_WITH_LIVEKIT_VERSION_TAG
    command: --config /etc/livekit.yaml
    expose:
      - 7880
    ports:
      - 7881:7881
      - 50100-50200:50100-50200/udp
    restart: always
    volumes:
      - ./storage/livekit/data/config.yaml:/etc/livekit.yaml:ro
    networks:
      traefik:
        aliases:
          - livekit
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=traefik"
      - "traefik.http.routers.livekit.entrypoints=websecure"
      - "traefik.http.routers.livekit.tls.certresolver=le"
      - "traefik.http.services.livekit.loadbalancer.server.port=7880"
      - "traefik.http.routers.livekit.middlewares=livekit-cors, livekit-prefix"
      - "traefik.http.routers.livekit.rule=Host(`REPLACE_WITH_MATRIX_RTC_HOST`) && PathPrefix(`/livekit/sfu`)"
      - 'traefik.http.middlewares.livekit-cors.headers.accesscontrolalloworiginlist="*"'
      - "traefik.http.middlewares.livekit-cors.headers.accesscontrolallowmethods=POST"
      - "traefik.http.middlewares.livekit-cors.headers.accesscontrolallowheaders=Accept, Content-Type, Content-Length, Accept-Encoding, X-CSRF-Token"
      - "traefik.http.middlewares.livekit-cors.headers.customrequestheaders.Connection=Upgrade"
      - "traefik.http.middlewares.livekit-cors.headers.customrequestheaders.Upgrade=WebSocket"
      - "traefik.http.middlewares.livekit-prefix.stripprefix.prefixes=/livekit/sfu"
  
