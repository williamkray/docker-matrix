## container versions
SYNAPSE_VERSION_TAG=latest
MAS_VERSION_TAG=latest
ELEMENT_VERSION_TAG=latest
POSTGRES_VERSION_TAG=18 ## the backup container uses the same version (<tag>-alpine)
MATRIX_JWT_VERSION_TAG=latest
LIVEKIT_VERSION_TAG=latest
## matrix-org/rust-synapse-compress-state image; its tags are git commits of that repo (or latest)
COMPRESSOR_VERSION_TAG=6a1327941c3e31cbd783b5c235201cdcbc69a689

## backups and maintenance (schedules are cron format, in TIMEZONE)
TIMEZONE=UTC                            ## e.g. America/New_York, Europe/Berlin (see /usr/share/zoneinfo)
DB_BACKUP_SCHEDULE="0 3 * * *"          ## nightly database dumps at 03:00
DB_BACKUP_KEEP=7                        ## how many dumps to keep in storage/backups/postgresql
DB_BACKUP_NTFY_URL=                     ## optional: ntfy topic URL (https://ntfy.sh/...) alerted when a dump fails
STATE_COMPRESSOR_SCHEDULE="30 4 * * *"  ## nightly synapse state compression at 04:30, after the dump
ROOM_PURGE_AFTER=28d                    ## purge a room this long after every local user has left (and forgotten) it

## the important bits
HOSTNAME=example.com
POSTGRES_PW=mysupersecurepassword
POSTGRES_MAS_PW=myothersupersecurepassword
POSTGRES_ROOT_PW=mysupersecurerootpassword

## change these if you don't like the defaults
#UID=${UID} ## uses the current running UID for the synapse container
SITE_HOST=www.${HOSTNAME}
MATRIX_HOST=synapse.${HOSTNAME}
MAS_HOST=mas.${HOSTNAME}
MATRIX_RTC_HOST=mrtc.${HOSTNAME}
ELEMENT_HOST=app.${HOSTNAME}
MAUBOT_HOST=maubot.${HOSTNAME}
REDIRECT_HOST=${ELEMENT_HOST} ## set to ${SITE_HOST} if you would prefer to redirect to a static site
ACME_EMAIL=admin@${HOSTNAME}
